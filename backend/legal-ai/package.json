{
  "name": "yemen-laws-legal-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "vectorize:create": "wrangler vectorize create yemen-laws-articles --dimensions=1024 --metric=cosine",
    "db:init:remote": "wrangler d1 execute yemen_laws_db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute yemen_laws_db --remote --file=./data/seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260920.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.36.0"
  }
}
